#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# No --refresh: the router already re-fetches when caches (catalog 2h, AA 24h)
# are stale, so startup is fast when they are fresh. Pass --refresh explicitly
# to force a re-fetch.
exec "$SCRIPT_DIR/.kilo/model-router/route-kilo" --tui "$@"
