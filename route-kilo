#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
RUNNER="$SCRIPT_DIR/.agents/.agent-runtime-router/run.py"
TARGET_RUNNER="$SCRIPT_DIR/.agents/runtime-router/adapters/kilo/run_arr_task.py"
if [[ ! -f "$RUNNER" ]]; then
  echo "ARR runtime is not installed in this checkout." >&2
  echo "Run the bootstrap-runtime-router plan/apply workflow first." >&2
  exit 64
fi
exec "$RUNNER" --python "$TARGET_RUNNER" --target "$SCRIPT_DIR" "$@"
