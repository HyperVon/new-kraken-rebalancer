<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Test diagnostics stay verbose: DEBUG preserves the pre-existing failure
         detail (SQL statements, cache decisions) while production runs at INFO. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="DEBUG">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
