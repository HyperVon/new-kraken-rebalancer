<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Production default: INFO. Debug database timing diagnostics stay
         available via explicit overrides. Individual DB calls of at least
         500 ms already log at WARN without any override. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
