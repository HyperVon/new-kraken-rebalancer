<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Production default: INFO. Without this file logback falls back to DEBUG,
         which logs every Exposed SQL statement (hundreds of per-candle UPSERTs per
         OHLC persist). Debug diagnostics stay available via explicit overrides.
         For DB/comparison timing diagnostics, run with -Dlogback.configurationFile
         pointing at a copy of this file that adds:
           <logger name="com.gemini.krakenbot.db.timing" level="DEBUG" />
           <logger name="com.gemini.krakenbot.service.impl.history.TradeHistoryQueryService" level="DEBUG" />
         Individual DB calls over 500ms already log at WARN without any override. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
