<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Diagnostics copy of backend/src/main/resources/logback.xml, selected at
         runtime with -Dlogback.configurationFile=logback-debug.xml (see start.bat
         debug mode). The override REPLACES the packaged logback.xml entirely, so
         the CONSOLE appender and INFO root are kept here to avoid losing output
         and to keep Exposed SQL logging quiet. The two DEBUG loggers enable DB
         call timings and comparison publication/digest diagnostics.
         Debug output also rolls to logs/rebalancer-debug.*.log (50 MB per file,
         5 files kept, ~250 MB cap) so a long run can be captured and shared. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/rebalancer-debug.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/rebalancer-debug.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>5</maxHistory>
            <totalSizeCap>250MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="com.gemini.krakenbot.db.timing" level="DEBUG" />
    <logger name="com.gemini.krakenbot.service.impl.history.TradeHistoryQueryService" level="DEBUG" />
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
