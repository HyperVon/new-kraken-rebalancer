      "await_charts": 4,
      "position": "top"
    },
    {
      "file": "history-charts.png",
      "path": "/history",
      "click_button": "30d",
      "await_charts": 4,
      "anchor": "Allocation Drift Over Time"
    },
    {
      "file": "history-bottom.png",
      "path": "/history",
      "click_button": "30d",
      "await_charts": 4,
      "anchor": "Trade History"
    }
  ]
