{
  "viewport": {
    "width": 1440,
    "height": 900,
    "deviceScaleFactor": 2
  },
  "targets": [
    {
      "file": "dashboard.png",
      "path": "/",
      "await_text": [
        "Kraken Rebalancer",
        "Total Portfolio",
        "Portfolio Allocation (Top Assets)",
        "Asset Performance",
        "Recent Activity"
      ],
      "position": "top"
    },
    {
      "file": "dashboard-bottom.png",
      "path": "/",
      "await_text": ["Recent Activity"],
      "position": "bottom"
    },
    {
      "file": "settings.png",
      "path": "/settings",
      "await_text": ["Global Parameters", "Safety Modes", "Target Allocations"],
      "position": "top"
    },
    {
      "file": "history.png",
      "path": "/history",
      "click_button": "30d",
      "await_text": [
        "Total Trades",
        "Rebalancer vs Buy & Hold"
      ],
      "await_charts": 5,
      "position": "top"
    },
    {
      "file": "history-portfolio-charts.png",
      "path": "/history",
      "click_button": "30d",
      "await_charts": 5,
      "anchor": "Portfolio Value Over Time",
      "await_text": ["Asset Holdings Over Time"]
    },
    {
      "file": "history-charts.png",
      "path": "/history",
      "click_button": "30d",
      "await_charts": 5,
      "anchor": "Allocation Deviation from Target",
      "await_text": ["Cumulative Net Cash Flow"],
      "ensure_visible": "Dry-run rows use estimated fees",
      "viewport": { "height": 1000 }
    },
    {
      "file": "history-bottom.png",
      "path": "/history",
      "click_button": "30d",
      "await_charts": 5,
      "anchor": "Trade History"
    }
  ]
}
