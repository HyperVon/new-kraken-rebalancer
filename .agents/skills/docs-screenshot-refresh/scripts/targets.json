{
  "viewport": {
    "width": 1440,
    "height": 900,
    "deviceScaleFactor": 2
  },
  "targets": [
    {
      "file": "dashboard.png",
      "path": "/",
      "await_text": ["Total Portfolio", "Recent Activity"],
      "position": "top"
    },
    {
      "file": "dashboard-bottom.png",
      "path": "/",
      "await_text": ["Recent Activity"],
      "position": "bottom"
    },
    {
      "file": "settings.png",
      "path": "/settings",
      "await_text": ["Global Parameters", "Target Allocations"],
      "position": "top"
    },
    {
      "file": "history.png",
      "path": "/history",
      "click_button": "30d",
