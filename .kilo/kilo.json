{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [
    ".kilo/shell-strategy.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": ["npx", "-y", "mcp-server-sqlite-npx", "kraken-rebalancer.db"],
      "enabled": false
    }
  },
  "permission": {
    "sqlite_write_query": "deny",
    "sqlite_create_table": "deny"
  }
}
