{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "kilo/kilo-auto/efficient",
  "instructions": [
    ".kilo/shell-strategy.md",
    ".agents/AGENTS.md",
    ".agents/OPERATING.md",
    ".kilo/model-router/instructions.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true
  },
  "lsp": false,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-server-sqlite-npx",
        "build/kilo-disposable.db"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "sqlite_write_query": "deny",
    "sqlite_create_table": "deny"
  },
  "plugin": [
    "context-mode"
  ],
  "snapshot": false
}