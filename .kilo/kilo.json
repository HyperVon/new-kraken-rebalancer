{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "kilo/kilo-auto/efficient",
  "instructions": [
    ".opencode/shell-strategy.md",
    ".agents/AGENTS.md",
    ".agents/OPERATING.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true
  },
  "lsp": false,
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": true
    }
  },
  "permission": {},
  "plugin": [
    "context-mode"
  ],
  "snapshot": false
}
