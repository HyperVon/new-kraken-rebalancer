#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
VENV_PY="$SCRIPT_DIR/.venv/bin/python"
if [[ ! -x "$VENV_PY" ]]; then
  echo "ERROR: ARR venv not found at $VENV_PY" >&2
  echo "Run: $SCRIPT_DIR/setup.sh" >&2
  exit 64
fi

if [[ -f "$SCRIPT_DIR/env.local" ]]; then
  set -a
  # shellcheck source=/dev/null
  . "$SCRIPT_DIR/env.local"
  set +a
fi

if [[ "${ARTIFICIAL_ANALYSIS_API_KEY:-}" == REPLACE_WITH_* ]]; then
  unset ARTIFICIAL_ANALYSIS_API_KEY
fi

exec "$VENV_PY" -u "$SCRIPT_DIR/router.py" run "$@"
