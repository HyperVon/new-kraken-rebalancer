{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/shell-strategy.md",
    ".agents/AGENTS.md",
    ".agents/OPERATING.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "intellij": {
      "type": "remote",
      "url": "http://127.0.0.1:64342/stream",
      "oauth": false
    },
    "zvec_grep": {
      "type": "local",
      "command": [
        "zg",
        "server",
        "--stdio"
      ],
      "timeout": 600000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "timeout": 120000
    }
  },
  "agent": {
    "adversarial-reviewer-a": {
      "description": "Fast capable reviewer for adversarial PR review (Reviewer A). Invoke via the Task tool when running the adversarial-pr-review skill. Read-only; inherits the parent session's model.",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "edit": "deny"
      }
    },
    "adversarial-reviewer-b": {
      "description": "Strong high-reasoning reviewer for adversarial PR review (Reviewer B). Invoke via the Task tool when running the adversarial-pr-review skill. Read-only; inherits the parent session's model.",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "edit": "deny"
      }
    }
  }
}
