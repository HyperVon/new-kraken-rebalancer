{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/shell-strategy.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  },
  "plugin": [
    "opencode-pty",
    "opencode-worktree",
    "opencode-vibeguard",
    "@tarquinen/opencode-dcp"
  ]
}